# Copy this file to .env (never commit .env)
# Run: python scripts/setup_wallets.py  -> fills these in automatically

XRPL_RPC_URL=https://s.altnet.rippletest.net:51234

TREASURY_ADDRESS=
TREASURY_SEED=
AGENT_ADDRESS=
AGENT_SEED=
RULES_SERVER_ADDRESS=
RULES_SERVER_SEED=
HONEST_SUPPLIER_ADDRESS=
HONEST_SUPPLIER_SEED=
FAKE_SUPPLIER_ADDRESS=
FAKE_SUPPLIER_SEED=

# Claude API key for the invoice-reading agent
ANTHROPIC_API_KEY=

# Rules server
RULES_SERVER_URL=http://localhost:8000
RULES_SERVER_API_KEY=
# CFO dashboard only - never give this to the agent
RULES_ADMIN_KEY=

# Privy agent wallet (dashboard.privy.io -> App settings). Then run scripts/setup_privy_wallet.py
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_MAX_XRP=20

# Dashboard staff sign-in (public transparency page needs no login)
DASHBOARD_CFO_PASSWORD=
DASHBOARD_FINANCE_PASSWORD=

# Payment signing: multisig (agent + rules server, after scripts/setup_multisig.py),
# privy (agent's Privy wallet), or master (demo fallback, Treasury seed alone)
SIGNING_MODE=

# Governance wallets (scripts/setup_governance_wallets.py)
CFO_ADDRESS=
CFO_SEED=
MUNICIPAL_MANAGER_ADDRESS=
MUNICIPAL_MANAGER_SEED=
